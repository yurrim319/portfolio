---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSortedProjects } from '../lib/projects';
import { getAllTags, getAllTypes } from '../lib/taxonomy';
import { BASE as base } from '../lib/site';

const projects = await getSortedProjects();
const tags = await getAllTags();
const types = await getAllTypes();
---
<SiteLayout title="yurim · dev">
  <div class="hero">
    <div class="hero-eyebrow">// <span>rendering engineer</span> · technical artist</div>
    <div class="hero-name">Rendering<br><strong>& Shader Work</strong></div>
    <div class="hero-role">Unreal Engine · C++ · HLSL · RDG</div>
    <div class="hero-desc">
      언리얼 엔진 렌더러 내부를 직접 수정하고, 그 과정을 기록합니다.
      엔진 소스 레벨의 RDG 파이프라인부터 커스텀 HLSL 셰이더까지.
    </div>
    <div class="stack">
      {tags.map(tag => (
        <a class={`stack-item${tag.highlight ? ' hi' : ''}`} href={`${base}tags/${tag.slug}`}>
          {tag.label}
        </a>
      ))}
    </div>
  </div>

  <div class="works">
    <div class="works-header">
      <div class="works-title">// works</div>
      <div class="works-count">{String(projects.length).padStart(2, '0')} / --</div>
    </div>
    {types.length > 0 && (
      <div class="category-row">
        <span class="category-label">category:</span>
        {types.map(type => (
          <a class="category-item" href={`${base}types/${type.slug}`}>{type.label}</a>
        ))}
      </div>
    )}
    {projects.map(entry => <ProjectCard entry={entry} />)}
  </div>
</SiteLayout>
